    "The device returned an invalid encrypted response." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "设备返回了无效的加密响应。" } } } },
    "The modem rejected the call command." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "通信模块拒绝了通话指令。" } } } },
