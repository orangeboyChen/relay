    "Enter a valid HTTPS server address." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请输入有效的 HTTPS 服务器地址。" } } } },
    "Not Connected" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未连接" } } } },
