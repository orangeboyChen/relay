APP_IDENTIFIER=com.nowcent.simdeck
APPLE_TEAM_ID=97YACL9S6W
# APP_STORE_CONNECT_TEAM_ID=YOUR_APP_STORE_CONNECT_TEAM_ID
# App Store Connect API Key authentication is optional. If omitted, fastlane
# uses Apple ID authentication through FASTLANE_USER/FASTLANE_SESSION or its
# interactive login flow.
# FASTLANE_USER=apple-id@example.com
# FASTLANE_SESSION=...
#
# Configure all three API Key values together when using API Key auth:
ASC_KEY_ID=YOUR_APP_STORE_CONNECT_KEY_ID
ASC_ISSUER_ID=YOUR_APP_STORE_CONNECT_ISSUER_ID
ASC_KEY_FILEPATH=/absolute/path/to/AuthKey_KEYID.p8
