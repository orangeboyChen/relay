default_platform(:ios)

require "fileutils"
require "shellwords"
require "tmpdir"

PROJECT = "SimDeck.xcodeproj"
SCHEME = "SimDeck"
TARGET = "SimDeck"
WEBRTC_VERSION = "154.0.0"
WEBRTC_DSYM_URL = "https://github.com/stasel/WebRTC/releases/download/#{WEBRTC_VERSION}/WebRTC-M154-dSYM.zip"

def required_environment_value(name)
  value = ENV[name]
  UI.user_error!("Missing required environment variable: #{name}") if value.to_s.empty?
  value
end

def app_store_connect_key
  app_store_connect_api_key(
    key_id: required_environment_value("ASC_KEY_ID"),
    issuer_id: required_environment_value("ASC_ISSUER_ID"),
    key_filepath: File.expand_path(required_environment_value("ASC_KEY_FILEPATH")),
    duration: 1200
  )
end

def app_store_connect_authentication
  api_key_variables = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_FILEPATH]
  configured_variables = api_key_variables.select { |name| !ENV[name].to_s.empty? }

  return {} if configured_variables.empty?

  missing_variables = api_key_variables - configured_variables
  UI.user_error!("Missing required environment variables: #{missing_variables.join(", ")}") unless missing_variables.empty?

  { api_key: app_store_connect_key }
end

def attach_webrtc_symbols(archive_path)
  cache_directory = File.expand_path("~/.cache/sim-deck")
  FileUtils.mkdir_p(cache_directory)
  archive_file = File.join(cache_directory, "WebRTC-M154-dSYM.zip")

  unless File.file?(archive_file)
    sh("curl --fail --location --retry 3 --silent --show-error #{WEBRTC_DSYM_URL.shellescape} --output #{archive_file.shellescape}")
  end

  destination_directory = File.join(archive_path, "dSYMs")
  FileUtils.mkdir_p(destination_directory)

  Dir.mktmpdir("sim-deck-webrtc-dsym") do |temporary_directory|
    sh("unzip -q #{archive_file.shellescape} WebRTC-ios-arm64.dSYM/'*' -d #{temporary_directory.shellescape}")
    source = File.join(temporary_directory, "WebRTC-ios-arm64.dSYM")
    UI.user_error!("WebRTC arm64 dSYM was not found in the symbol archive") unless File.directory?(source)
    FileUtils.rm_rf(File.join(destination_directory, "WebRTC-ios-arm64.dSYM"))
    FileUtils.cp_r(source, destination_directory)
  end
end

platform :ios do
  desc "Build Sim Deck and upload the next build to TestFlight"
  lane :beta do |options|
    authentication = app_store_connect_authentication

    increment_version_number(
      version_number: options[:version],
      xcodeproj: PROJECT
    ) if options[:version]

    version = get_version_number(
      xcodeproj: PROJECT,
      target: TARGET
    )

    local_build_number = get_build_number(xcodeproj: PROJECT).to_i
    testflight_build_number = latest_testflight_build_number(
      version: version,
      initial_build_number: 0,
      **authentication
    ).to_i
    next_build_number = [local_build_number, testflight_build_number].max + 1

    increment_build_number(
      build_number: next_build_number,
      xcodeproj: PROJECT,
      skip_info_plist: true
    )

    UI.message("Uploading Sim Deck #{version} (#{next_build_number})")

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      skip_package_ipa: true,
      output_directory: "build/fastlane",
      output_name: "SimDeck.ipa"
    )

    archive_path = lane_context[SharedValues::XCODEBUILD_ARCHIVE]
    UI.user_error!("The Xcode archive path was not produced") if archive_path.to_s.empty?
    attach_webrtc_symbols(archive_path)

    export_options_path = File.join(Dir.mktmpdir("sim-deck-export"), "ExportOptions.plist")
    File.write(export_options_path, <<~PLIST)
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0"><dict><key>method</key><string>app-store-connect</string></dict></plist>
    PLIST
    sh("xcodebuild -exportArchive -archivePath #{archive_path.shellescape} -exportOptionsPlist #{export_options_path.shellescape} -exportPath build/fastlane")
    ipa_path = File.expand_path("build/fastlane/SimDeck.ipa")
    UI.user_error!("The exported IPA was not found") unless File.file?(ipa_path)

    upload_to_testflight(
      ipa: ipa_path,
      changelog: options[:changelog],
      distribute_external: false,
      skip_waiting_for_build_processing: true,
      **authentication
    )
  end
end
