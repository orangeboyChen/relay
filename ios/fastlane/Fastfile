default_platform(:ios)

require "fileutils"
require "cfpropertylist"
require "open3"
require "shellwords"
require "tmpdir"

PROJECT = "SimDeck.xcodeproj"
SCHEME = "SimDeck"
TARGET = "SimDeck"
WEBRTC_VERSION = "154.0.0"
WEBRTC_DSYM_URL = "https://github.com/stasel/WebRTC/releases/download/#{WEBRTC_VERSION}/WebRTC-M154-dSYM.zip"

def required_environment_value(name)
  value = ENV[name]
  UI.user_error!("Missing required environment variable: #{name}") if value.to_s.empty?
  value
end

def app_store_connect_key
  app_store_connect_api_key(
    key_id: required_environment_value("ASC_KEY_ID"),
    issuer_id: required_environment_value("ASC_ISSUER_ID"),
    key_filepath: File.expand_path(required_environment_value("ASC_KEY_FILEPATH")),
    duration: 1200
  )
end

def app_store_connect_authentication
  if !ENV["FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD"].to_s.empty?
    username = ENV["FASTLANE_USER"] || CredentialsManager::AppfileConfig.try_fetch_value(:apple_id)
    UI.user_error!("An Apple ID username is required with FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD") if username.to_s.empty?

    return { username: username }
  end

  api_key_variables = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_FILEPATH]
  configured_variables = api_key_variables.select { |name| !ENV[name].to_s.empty? }

  unless configured_variables.empty?
    missing_variables = api_key_variables - configured_variables
    UI.user_error!("Missing required environment variables: #{missing_variables.join(", ")}") unless missing_variables.empty?

    return { api_key: app_store_connect_key }
  end

  {}
end

def app_store_connect_app_apple_id
  app_identifier = ENV.fetch("APP_IDENTIFIER", "com.nowcent.simdeck")
  app = Spaceship::ConnectAPI::App.find(app_identifier)
  UI.user_error!("Could not find App Store Connect app with bundle identifier: #{app_identifier}") unless app
  app.id
end

def next_testflight_build_number(local_build_number, testflight_build_number)
  return local_build_number if local_build_number > testflight_build_number

  testflight_build_number + 1
end

def read_binary_plist(path)
  list = CFPropertyList::List.new(file: path)
  CFPropertyList.native_types(list.value)
end

def validate_archive_metadata(archive_path, version, build_number)
  app_path = File.join(archive_path, "Products", "Applications", "SimDeck.app")
  app_info = read_binary_plist(File.join(app_path, "Info.plist"))
  required_usage_descriptions = %w[NSCameraUsageDescription NSContactsUsageDescription]
  missing_descriptions = required_usage_descriptions.select { |key| app_info[key].to_s.strip.empty? }
  UI.user_error!("Archive is missing purpose strings: #{missing_descriptions.join(", ")}") unless missing_descriptions.empty?
  unless app_info["ITSAppUsesNonExemptEncryption"] == false
    UI.user_error!("Archive must declare ITSAppUsesNonExemptEncryption as false")
  end

  bundles = [app_path] + Dir.glob(File.join(app_path, "PlugIns", "*.appex"))
  bundles.each do |bundle|
    info = read_binary_plist(File.join(bundle, "Info.plist"))
    UI.user_error!("#{File.basename(bundle)} has version #{info["CFBundleShortVersionString"]}, expected #{version}") unless info["CFBundleShortVersionString"] == version
    UI.user_error!("#{File.basename(bundle)} has build #{info["CFBundleVersion"]}, expected #{build_number}") unless info["CFBundleVersion"] == build_number.to_s
  end

  entitlements_data, _, status = Open3.capture3("codesign", "-d", "--entitlements", ":-", app_path)
  UI.user_error!("Could not read archived app entitlements") unless status.success?
  entitlements = CFPropertyList.native_types(CFPropertyList::List.new(data: entitlements_data).value)
  autofill_key = "com.apple.developer.authentication-services.autofill-credential-provider"
  UI.user_error!("Archived app is missing the AutoFill credential provider entitlement") unless entitlements[autofill_key] == true

  communication_key = "com.apple.developer.usernotifications.communication"
  if entitlements[communication_key] == true
    required_activity_types = %w[INSendMessageIntent INStartCallIntent]
    activity_types = Array(app_info["NSUserActivityTypes"])
    missing_activity_types = required_activity_types - activity_types
    unless missing_activity_types.empty?
      UI.user_error!("Archive is missing communication activity types: #{missing_activity_types.join(", ")}")
    end
  end
end

def attach_webrtc_symbols(archive_path)
  cache_directory = File.expand_path("~/.cache/sim-deck")
  FileUtils.mkdir_p(cache_directory)
  archive_file = File.join(cache_directory, "WebRTC-M154-dSYM.zip")

  unless File.file?(archive_file)
    sh("curl --fail --location --retry 3 --silent --show-error #{WEBRTC_DSYM_URL.shellescape} --output #{archive_file.shellescape}")
  end

  destination_directory = File.join(archive_path, "dSYMs")
  FileUtils.mkdir_p(destination_directory)

  Dir.mktmpdir("sim-deck-webrtc-dsym") do |temporary_directory|
    sh("unzip -q #{archive_file.shellescape} WebRTC-ios-arm64.dSYM/'*' -d #{temporary_directory.shellescape}")
    source = File.join(temporary_directory, "WebRTC-ios-arm64.dSYM")
    UI.user_error!("WebRTC arm64 dSYM was not found in the symbol archive") unless File.directory?(source)
    FileUtils.rm_rf(File.join(destination_directory, "WebRTC-ios-arm64.dSYM"))
    FileUtils.cp_r(source, destination_directory)
  end
end

platform :ios do
  desc "Build Sim Deck and upload the next build to TestFlight"
  lane :beta do |options|
    authentication = app_store_connect_authentication

    increment_version_number(
      version_number: options[:version],
      xcodeproj: PROJECT
    ) if options[:version]

    version = get_version_number(
      xcodeproj: PROJECT,
      target: TARGET
    )

    local_build_number = get_build_number(xcodeproj: PROJECT).to_i
    testflight_build_number = latest_testflight_build_number(
      version: version,
      initial_build_number: 0,
      **authentication.slice(:api_key, :username)
    ).to_i

    authentication[:apple_id] = app_store_connect_app_apple_id if authentication.key?(:username)
    next_build_number = next_testflight_build_number(local_build_number, testflight_build_number)

    increment_build_number(
      build_number: next_build_number,
      xcodeproj: PROJECT,
      skip_info_plist: true
    )

    UI.message("Uploading Sim Deck #{version} (#{next_build_number})")

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      clean: true,
      xcargs: "-allowProvisioningUpdates",
      export_method: "app-store",
      skip_package_ipa: true,
      output_directory: "build/fastlane",
      output_name: "SimDeck.ipa"
    )

    archive_path = lane_context[SharedValues::XCODEBUILD_ARCHIVE]
    UI.user_error!("The Xcode archive path was not produced") if archive_path.to_s.empty?
    validate_archive_metadata(archive_path, version, next_build_number)
    attach_webrtc_symbols(archive_path)

    export_options_path = File.join(Dir.mktmpdir("sim-deck-export"), "ExportOptions.plist")
    File.write(export_options_path, <<~PLIST)
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0"><dict><key>method</key><string>app-store-connect</string></dict></plist>
    PLIST
    sh("xcodebuild -exportArchive -allowProvisioningUpdates -archivePath #{archive_path.shellescape} -exportOptionsPlist #{export_options_path.shellescape} -exportPath build/fastlane")
    ipa_path = File.expand_path("build/fastlane/SimDeck.ipa")
    UI.user_error!("The exported IPA was not found") unless File.file?(ipa_path)

    upload_to_testflight(
      ipa: ipa_path,
      changelog: options[:changelog],
      distribute_external: false,
      skip_waiting_for_build_processing: true,
      **authentication
    )
  end
end
